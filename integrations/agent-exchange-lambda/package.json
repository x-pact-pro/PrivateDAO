{
  "name": "privatedao-agent-exchange",
  "version": "1.7.5",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test:surfaces": "AGENT_EXCHANGE_TEST_MODE=true AGENT_EXCHANGE_ALLOW_TEST_STORAGE=true AGENT_EXCHANGE_MCP_FETCH_FIXTURE=true AGENT_EXCHANGE_RPC_FIXTURE=true node --test test/surfaces.mjs",
    "test:browser": "AGENT_EXCHANGE_TEST_MODE=true AGENT_EXCHANGE_MCP_FETCH_FIXTURE=true AGENT_EXCHANGE_RPC_FIXTURE=true node test/e2e/browser-seller.mjs",
    "test": "AGENT_EXCHANGE_TEST_MODE=true AGENT_EXCHANGE_ALLOW_TEST_STORAGE=true AGENT_EXCHANGE_MCP_FETCH_FIXTURE=true AGENT_EXCHANGE_RPC_FIXTURE=true node --test --test-concurrency=1 test/*.mjs",
    "smoke": "AGENT_EXCHANGE_TEST_MODE=true AGENT_EXCHANGE_ALLOW_TEST_STORAGE=true AGENT_EXCHANGE_MCP_FETCH_FIXTURE=true AGENT_EXCHANGE_RPC_FIXTURE=true node test/smoke.mjs",
    "verify:live-surface": "node scripts/verify-live-surface.mjs",
    "privatepay:audit": "node scripts/privatepay-conformance.mjs",
    "privatepay:delegation-audit": "node scripts/privatepay-delegation-audit.mjs",
    "privatepay:release-evidence": "node scripts/privatepay-release-evidence.mjs",
    "privatepay:merchant-deposit": "node scripts/privatepay-merchant-deposit-builder.mjs",
    "privatepay:provider-preflight": "node scripts/privatepay-provider-checkout-preflight.mjs",
    "privatepay:x402-artifact": "node scripts/privatepay-x402-artifact.mjs",
    "privatepay:x402-status": "node scripts/privatepay-x402-status.mjs",
    "privatepay:x402-verify-settle": "node scripts/privatepay-x402-verify-settle.mjs",
    "privatepay:x402-submit": "node scripts/privatepay-x402-submit.mjs",
    "lint": "node --check src/*.mjs test/*.mjs scripts/*.mjs",
    "package": "bash scripts/package-lambda.sh"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1136.0",
    "@aws-sdk/client-secrets-manager": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1136.0",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.17.3",
    "@solana/web3.js": "1.98.4",
    "@x402/core": "^2.28.0",
    "mongodb": "^6.20.0",
    "tweetnacl": "^1.0.3"
  },
  "devDependencies": {
    "8004-solana": "0.8.3",
    "esbuild": "0.28.2",
    "playwright": "^1.64.1"
  },
  "overrides": {
    "rpc-websockets": "9.3.3",
    "stream-json": "^3.6.0",
    "uuid": "^11.1.1",
    "zod": "^4.6.7"
  }
}
